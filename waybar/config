// -*- mode: json -*-

{
	"layer": "top",
	"position": "top",

	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["clock#2"],
	"modules-right": ["cpu", "memory", "network", "pulseaudio", "battery", "custom/claude-usage", "custom/codex-usage"],

  "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "hyprctl dispatch workspace {id}",
        "format-icons": {
            "1": "",   
            "2": "󰈹",
            //"3": "",
            "3": "", 
            "8": "",
            "9": "󰍹",
           "urgent": "" // Icon for urgent windows
//            "default": ""  // Default fallback icon
        }
    },

	"custom/left-arrow-dark": {
		"format": "",
		"tooltip": false
	},
	"custom/left-arrow-light": {
		"format": "",
		"tooltip": false
	},
	"custom/right-arrow-dark": {
		"format": "",
		"tooltip": false
	},
	"custom/right-arrow-light": {
		"format": "",
		"tooltip": false
	},

	"wlr/workspaces": {
		"disable-scroll": true,
		"format": "{name}"
	},

	"clock#1": {
		"format": "{:%a}",
		"tooltip": false
	},
	"clock#2": {
    "format": "{:%H:%M}",
		"tooltip": false
	},
	"clock#3": {
		"format": "{:%m-%d}",
		"tooltip": false
	},

	"pulseaudio": {
		"format": "{icon} {volume:2}%",
		"format-bluetooth": "{icon}  {volume}%",
		"format-muted": "MUTE",
		"format-icons": {
			"headphones": "",
			"default": [
				"",
				""
			]
		},
		"scroll-step": 5,
		"on-click": "pavucontrol",
		"on-click-right": "pamixer -t"	
	},
	"memory": {
		"interval": 5,
		"format": "Mem {}%"
	},
	"cpu": {
		"interval": 5,
		"on-click": "emacsclient -c -e '(proced)'",
		"format": "CPU {usage:2}%"
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
    "format-charging": " {icon} {capacity}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"tray": {
		"icon-size": 20
	},
	"network": {
		"interface": "wlp0s20f3",
		"format": "{ifname}",
		"format-wifi": "({signalStrength}%) ",
		"format-ethernet": "{ifname} ",
		"format-disconnected": "", //An empty format will hide the module.
		"tooltip-format": "{ifname}",
		"tooltip-format-wifi": "{essid} ({signalStrength}%) ",
		"tooltip-format-ethernet": "{ifname} ",
		"tooltip-format-disconnected": "Disconnected",
		"on-click": "emacsclient -c -e '(view-file \"~/Documents/tech-personal-notes/nmcli-help.org\")'",
		"max-length": 50
	},
	"backlight": {
	    	"device": "intel_backlight",
	        "format": "{percent}% {icon}",
		"format-icons": ["", ""]
	},

	"custom/claude-usage": {
		"exec": "/usr/bin/claude-usage --waybar --format '{icon_plain} 5h {5h_pct}% · {icon_plain} W {7d_pct}% · {time_icon_plain} {5h_reset}' --tooltip-format 'Claude usage\\n5-hour: {5h_pct}% · resets in {5h_reset}\\nWeekly: {7d_pct}% · resets in {7d_reset}'",
		"return-type": "json",
		"interval": 120,
		"format": "{}",
		"tooltip": true,
		"on-click": "pkill -RTMIN+8 waybar",
		"signal": 8
	},

	"custom/codex-usage": {
		"exec": "/usr/bin/codex-usage --waybar --format '{icon_plain} 5h {5h_pct}% · {icon_plain} W {7d_pct}% · {time_icon_plain} {5h_reset}' --tooltip-format 'Codex usage\\n5-hour: {5h_pct}% · resets in {5h_reset}\\nWeekly: {7d_pct}% · resets in {7d_reset}'",
		"return-type": "json",
		"interval": 120,
		"format": "{}",
		"tooltip": true,
		"on-click": "pkill -RTMIN+9 waybar",
		"signal": 9
	}
}
